{
  "name": "settl",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@noirx402/agent-sdk@0.3.0": {
      "@stellar/stellar-sdk": "17.0.0"
    }
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "demo": "python3 scripts/run_demo.py",
    "demo:fast": "python3 scripts/run_demo.py --no-pause --auto-approve"
  }
}

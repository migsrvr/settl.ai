# Copy to apps/web/.env.local and fill in. Never commit real values.

# Stellar testnet and Noir contracts (from Builder Handbook redeploy 2026-10-24)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NOIR_DEVICE_REGISTRY_ID=CAC4KOLHDLDYDWBOKXNKRN5KVHO56PLOIFXDLTBUWGVN6GVDEB7FQHU5
NOIR_AGENT_REGISTRY_ID=CCMZDSPTLX7IIJWCYEUM5DJUHOSOYSTHGK777S2TXZWEMC5ZZGPJ3EBV
NOIR_PAYMENT_ESCROW_ID=CC7EAW5FNJEDBS7THM5IT6XIOHO4AOYMLXT3KSZ3HWUIKEACTW7E5BFS

# Velo (velo-build.dev). The Gas Station key is separate from the API key.
VELO_API_KEY=
VELO_WEBHOOK_SECRET=
VELO_GAS_API_KEY=
VELO_GAS_ENV=testnet

# Neon Postgres
DATABASE_URL=

# 32-byte hex key for encrypting custodial testnet wallet secrets
WALLET_ENC_KEY=

# Optional override for the public testnet seed token; only its SHA-256 hash is stored
# DEMO_AGENT_API_KEY=stl_agent_bookkeeper_demo

# Shared testnet provider service credential (required for quote/verification routes)
SETTL_PROVIDER_KEY=
SETTL_API_URL=http://localhost:3000
# Origins approved for provider endpoint registration (comma-separated; no path)
SETTL_PROVIDER_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional funded testnet relayer; otherwise the broker uses SETTL_TREASURY_SECRET
SETTL_RELAYER_SECRET=

# Demo exchange rate for showing XLM prices in pesos
PHP_PER_XLM=15

# Settl treasury wallet that funds escrows after Velo top-ups (testnet secret)
SETTL_TREASURY_SECRET=

# POST /api/cron/auto-claim authentication; configure an external recurring POST job
CRON_SECRET=

# Standalone Bookkeeper CLI: export these in its launching environment
SETTL_MCP_URL=http://localhost:3000/mcp
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# AGENT_MODEL=
# AGENT_LEDGER_PATH=

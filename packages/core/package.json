{
  "name": "@settl/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build && node ../../scripts/publish-manifest.mjs apply",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "description": "Quotes, payment headers, receipts and amount helpers shared by Settl packages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/migsrvr/settl.ai.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.2.0"
  },
  "publishManifest": {
    "private": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}

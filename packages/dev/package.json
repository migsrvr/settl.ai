{
  "name": "@settl/dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run a local Settl gateway with fake money: no database, wallets or accounts needed.",
  "bin": {
    "settl-dev": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx --tsconfig ./tsconfig.json src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema": "node scripts/generate-schema.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@settl/core": "^0.1.0",
    "@stellar/stellar-sdk": "^17.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@settl/sdk": "^0.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "express": "^5.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.7"
  }
}

{
  "name": "@settl/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let an AI agent discover and pay for Settl services: a typed client for the Settl MCP, with approval handling and Vercel AI SDK tools.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai.ts"
  },
  "repository": { "type": "git", "url": "git+https://github.com/migsrvr/settl.ai.git", "directory": "packages/client" },
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build && node ../../scripts/publish-manifest.mjs apply",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@settl/core": "^0.1.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@settl/dev": "^0.1.0",
    "@settl/sdk": "^0.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "ai": "7.0.163",
    "express": "^5.1.0",
    "vitest": "^3.2.7",
    "zod": "^4.2.0"
  },
  "publishManifest": {
    "private": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
      "./ai": { "types": "./dist/ai.d.ts", "import": "./dist/ai.js", "require": "./dist/ai.cjs" }
    }
  }
}

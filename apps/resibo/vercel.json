{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @settl/resibo",
  "functions": {
    "api/index.mjs": { "maxDuration": 300, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
